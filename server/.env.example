NODE_ENV=development
PORT=5000
# Production binds to 127.0.0.1 automatically; development binds to 0.0.0.0.
# On EC2 set PORT=5001 to match the documented Nginx upstream.
# Set CLIENT_URL below to the final HTTPS website origin in production.

# Local development database; must be a replica set (uploads/payment review use transactions)
MONGODB_URI_DEVELOPMENT=mongodb://127.0.0.1:27017/funfair?replicaSet=rs0

# Private MongoDB Atlas URI; configure only outside source control
MONGODB_URI_PRODUCTION=

JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# All objects stay PRIVATE. Only the API serves image bytes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=funfair-media
