NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/funfair?replicaSet=rs0
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional development seed administrator (leave blank to skip)
SEED_ADMIN_NAME=funfairadmin
SEED_ADMIN_PASSWORD=

# All objects stay PRIVATE. Only the API serves image bytes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=funfair-media
