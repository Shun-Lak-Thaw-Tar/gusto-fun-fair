{
  "name": "funfair-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend Architecture V1 for the Fun Fair pre-order system",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:demo": "node seed/seedDemo.js",
    "migrate:foods": "node scripts/migrateFoodItems.js",
    "test": "node scripts/run-tests.js",
    "test:unit": "node --test test/pricingService.test.js test/ticketCode.test.js test/v11Validation.test.js test/v12Structure.test.js test/mediaValidation.test.js",
    "r2:setup": "node scripts/setup-r2.js",
    "media:cleanup": "node scripts/cleanup-media.js",
    "migrate:media": "node scripts/migrate-media.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "multer": "^2.3.0",
    "sharp": "^0.35.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.10"
  }
}
